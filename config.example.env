# Lanhu MCP Server Configuration
# Last reviewed: 2026-05-08 09:17
# Copy this file to .env and fill in your values

# 蓝湖 MCP 服务器配置示例
# 复制此文件为 .env 并填入你的配置值
# ⚠️ 注意：不要将 .env 文件提交到 git！

# ==============================================
# Cookie Configuration
# ==============================================

# Lanhu Cookie (optional fallback)
# - stdio mode: prefer setting env.LANHU_COOKIE in your AI tool MCP config.
# - HTTP shared server: prefer setting headers.X-Lanhu-Cookie per MCP client/user.
# - This .env value remains only as a single-user/default fallback.
LANHU_COOKIE="your_lanhu_cookie_here"

# DDS Cookie (optional; defaults to LANHU_COOKIE when empty)
DDS_COOKIE=""

# MCP transport: http (default) or stdio
MCP_TRANSPORT="http"

# ==============================================
# Server Configuration
# ==============================================

# Server host. Use 127.0.0.1 for local-only access.
SERVER_HOST="127.0.0.1"

# Server port for HTTP transport.
SERVER_PORT=8000

# ==============================================
# Feishu Bot Configuration (Optional)
# ==============================================

# Leave empty to disable Feishu notifications.
FEISHU_WEBHOOK_URL=""

# ==============================================
# Storage Configuration
# ==============================================

DATA_DIR="./data"

# ==============================================
# Performance Configuration
# ==============================================

HTTP_TIMEOUT=30
VIEWPORT_WIDTH=1920
VIEWPORT_HEIGHT=1080

# ==============================================
# Development Configuration
# ==============================================

DEBUG="false"

# ==============================================
# Usage Notes
# ==============================================
#
# 1. Cookie security:
#    - Keep LANHU_COOKIE private.
#    - Do not put cookies in URL query parameters.
#    - Do not commit .env files.
#
# 2. MCP client examples:
#
#    stdio:
#    {
#      "mcpServers": {
#        "lanhu": {
#          "command": "python",
#          "args": ["E:/AiProject/lanhu-mcp/lanhu_mcp_server.py"],
#          "env": {
#            "MCP_TRANSPORT": "stdio",
#            "LANHU_COOKIE": "your_lanhu_cookie_here"
#          }
#        }
#      }
#    }
#
#    HTTP shared server:
#    {
#      "mcpServers": {
#        "lanhu": {
#          "url": "http://localhost:8000/mcp?role=Developer&name=YourName",
#          "headers": {
#            "X-Lanhu-Cookie": "your_lanhu_cookie_here"
#          }
#        }
#      }
#    }
