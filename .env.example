# Lanhu MCP Server environment defaults
# Copy to .env only when you need process-level fallback values.
# Do not commit real cookies.

# Optional fallback cookie.
# stdio users should prefer MCP config env.LANHU_COOKIE.
# HTTP shared-server users should prefer MCP config headers.X-Lanhu-Cookie.
LANHU_COOKIE="your_lanhu_cookie_here"

# Optional DDS cookie. Defaults to LANHU_COOKIE when empty.
DDS_COOKIE=""

# Transport: http (default) or stdio.
MCP_TRANSPORT="http"

# HTTP server options.
SERVER_HOST="127.0.0.1"
SERVER_PORT=8000

# Optional integrations.
FEISHU_WEBHOOK_URL=""

# Runtime storage and performance.
DATA_DIR="./data"
LOG_LEVEL="INFO"
LOG_DIR="./logs"
CACHE_TTL=3600
MAX_CONCURRENT_DOWNLOADS=5
HTTP_TIMEOUT=30
VIEWPORT_WIDTH=1920
VIEWPORT_HEIGHT=1080

# Development.
DEBUG="false"
HOT_RELOAD="false"
